@baseUrl = http://localhost:3007
@authToken = {{authenticate.response.body.access_token}}
###
# @name create_account
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "email": "diego@example.com",
  "name": "John Doe",
  "password": "securepassword"
}

### 

# @name authenticate
POST {{baseUrl}}/sessions
Content-Type: application/json

{
  "email": "diego@example.com",  
  "password": "securepassword"
}
###
# @name create_question
POST {{baseUrl}}/questions
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "How to learn NestJS? 7",
  "content": "I want to learn NestJS, any tips?"
}
###
# @name fetch_recent_questions
GET {{baseUrl}}/health
Content-Type: application/json
Authorization: Bearer {{authToken}}

###

GET {{baseUrl}}/health
###
POST {{baseUrl}}/v1/conseption
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "Harmonizacao": [
    { "produto": 1, "harmonizacoes": "1" },
    { "produto": 2, "harmonizacoes": "1,2" },
    { "produto": 3, "harmonizacoes": "2,3" },
    { "produto": 4, "harmonizacoes": "1,3" },
    { "produto": 5, "harmonizacoes": "1,2,3" },
    { "produto": 6, "harmonizacoes": "2" },
    { "produto": 7, "harmonizacoes": "3" },
    { "produto": 8, "harmonizacoes": "1,2,3" },
    { "produto": 9, "harmonizacoes": "1" },
