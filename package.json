{
  "name": "v2",
  "version": "1.0.0",
  "description": "this is a new project",
  "keywords": [
    "api"
  ],
  "homepage": "https://github.com/elvis7t/api_lista_rango#readme",
  "bugs": {
    "url": "https://github.com/elvis7t/api_lista_rango/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elvis7t/api_lista_rango.git"
  },
  "license": "UNLICENSED",
  "author": "Elvis Leite",
  "type": "module",
  "main": "dist/infrastructure/main/index.js",
  "imports": {
    "#domain/*": "./dist/domain/*",
    "#application/*": "./dist/application/*",
    "#infrastructure/*": "./dist/infrastructure/*"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/infrastructure/main/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/infrastructure/main/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:studio": "sh -c 'prisma studio --browser none --port ${PRISMA_STUDIO_PORT:-5555}'",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:reset": "prisma migrate reset",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "sh -c 'vitest --ui --api ${VITEST_UI_PORT:-51204} --open false'",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run prisma:validate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.62.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "jose": "^6.2.8",
    "pg": "^8.21.0",
    "prisma": "^6.12.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  }
}
